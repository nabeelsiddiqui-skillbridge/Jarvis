# ============================================================================
# Business Command AI — configuration
# Copy to .env and fill in. Secrets stay on the server; the browser never sees them.
# ============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=8787
# PostgreSQL (16+). Supabase Postgres works too — use its direct connection string.
DATABASE_URL=postgres://postgres@localhost:5432/bca_dev
# 32+ random bytes, e.g. `openssl rand -base64 32`. Encrypts provider tokens at rest.
# REQUIRED in production. Losing it means every connection must be re-authorized.
ENCRYPTION_KEY=
# Public URLs (OAuth redirect URIs, webhook URLs and invitation links are built from these).
APP_URL=http://localhost:5173
API_URL=http://localhost:8787
# Behind a reverse proxy: number of hops or "true" (so rate limits see real client IPs).
TRUST_PROXY=
# Set to "false" to disable public sign-up.
ALLOW_SIGNUP=true
# Comma-separated emails that become platform administrators when they sign up.
PLATFORM_ADMIN_EMAILS=

# --- Shopify (live connector) -------------------------------------------------
# Create an app in the Shopify Partner Dashboard / Dev Dashboard.
# Allowed redirect URL: <API_URL>/api/oauth/shopify/callback
# Webhooks are registered automatically when API_URL is public HTTPS:
#   <API_URL>/api/webhooks/shopify   (also set it for the mandatory compliance topics
#   customers/data_request, customers/redact, shop/redact in your app config)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Admin API version (pin; review quarterly).
SHOPIFY_API_VERSION=2026-07
# Request read_all_orders (order history > 60 days) once Shopify has approved it for your app.
SHOPIFY_REQUEST_ALL_ORDERS=false

# --- Worker -------------------------------------------------------------------
WORKER_CONCURRENCY=3
# Comma-separated connector ids whose provider approval is pending (shown as "Provider access pending").
PROVIDER_ACCESS_PENDING=
