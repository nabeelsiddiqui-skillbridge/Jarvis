# ============================================================================
# Business Command AI — configuration
# Copy to .env and fill in. Secrets stay on the server; the browser never sees them.
# ============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=8787
# PostgreSQL (16+). Supabase Postgres works too — use its direct connection string.
DATABASE_URL=postgres://postgres@localhost:5432/bca_dev
# 32+ random bytes, e.g. `openssl rand -base64 32`. Encrypts provider tokens at rest.
# REQUIRED in production. Losing it means every connection must be re-authorized.
ENCRYPTION_KEY=
# Public URLs (OAuth redirect URIs, webhook URLs and invitation links are built from these).
APP_URL=http://localhost:5173
API_URL=http://localhost:8787
# Behind a reverse proxy: number of hops or "true" (so rate limits see real client IPs).
TRUST_PROXY=
# Set to "false" to disable public sign-up.
ALLOW_SIGNUP=true
# Comma-separated emails that are platform administrators (admin console, audited support access).
# Applied at sign-up and on every API start: removing an email removes the access after a restart.
PLATFORM_ADMIN_EMAILS=

# --- AI assistant (Claude) ------------------------------------------------------
# Server-side only; never sent to the browser. Without it the assistant explains it isn't configured.
ANTHROPIC_API_KEY=
# Model and reasoning effort (low | medium | high). Defaults: claude-opus-5-5, medium.
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=medium
# Per-user daily message cap (cost control).
ASSISTANT_DAILY_MESSAGES=300

# --- Voice (optional) -------------------------------------------------------------
# Deepgram streaming speech-to-text + text-to-speech. The browser opens the speech
# socket with a ~30 s token minted by the server; the key itself never leaves the server.
# Without it, voice falls back to the browser's built-in speech (Chrome, Edge, Safari).
DEEPGRAM_API_KEY=
VOICE_STT_MODEL=nova-3
VOICE_TTS_MODEL=aura-2-thalia-en
VOICE_LANGUAGE=en
# How the browser presents the temporary token on the WebSocket (Sec-WebSocket-Protocol: <scheme>, <token>).
VOICE_WS_AUTH_SCHEME=bearer

# ElevenLabs (optional): natural voices each user can choose (Account → JARVIS voice).
# When set, spoken answers use ElevenLabs; speech recognition still uses Deepgram or the browser.
ELEVENLABS_API_KEY=
# Default voice id and model (defaults: Rachel 21m00Tcm4TlvDq8ikWAM, eleven_flash_v2_5).
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_MODEL=

# Provider credentials below (Shopify, Google, HubSpot, AI, voice, Stripe, email) can also be
# entered in the app: Platform admin → Credentials. Values set here take precedence.

# --- Shopify (live connector) -------------------------------------------------
# Create an app in the Shopify Partner Dashboard / Dev Dashboard.
# Allowed redirect URL: <API_URL>/api/oauth/shopify/callback
# Webhooks are registered automatically when API_URL is public HTTPS:
#   <API_URL>/api/webhooks/shopify   (also set it for the mandatory compliance topics
#   customers/data_request, customers/redact, shop/redact in your app config)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Admin API version (pin; review quarterly).
SHOPIFY_API_VERSION=2026-07
# Request read_all_orders (order history > 60 days) once Shopify has approved it for your app.
SHOPIFY_REQUEST_ALL_ORDERS=false

# --- Google (GA4, Search Console, Google Ads) -------------------------------------
# One OAuth client (type "Web application") in Google Cloud serves all three.
# Authorized redirect URIs:
#   <API_URL>/api/oauth/ga4/callback
#   <API_URL>/api/oauth/gsc/callback
#   <API_URL>/api/oauth/google_ads/callback
# Enable: Google Analytics Data API, Google Analytics Admin API, Google Search Console API,
# Google Ads API. analytics.readonly / webmasters.readonly / adwords are sensitive scopes:
# until Google verifies the OAuth app, only listed test users can connect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Ads developer token (manager account → API Center). Needs Basic or Standard
# access for real accounts; a test-level token only reaches test accounts.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v25

# --- HubSpot ------------------------------------------------------------------
# Public app in a HubSpot developer account. Redirect URL: <API_URL>/api/oauth/hubspot/callback
# Scopes: oauth crm.objects.contacts.read crm.objects.deals.read
# Optional webhooks (contact/deal creation, propertyChange, deletion) → <API_URL>/api/webhooks/hubspot
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Set to true to also request crm.objects.deals.write so approved actions can move deals.
# Add that scope to the HubSpot app first; existing connections must reconnect.
HUBSPOT_ENABLE_ACTIONS=false

# --- Billing (Stripe, optional) ---------------------------------------------------
# Without these, workspaces still get the 14-day trial and Free-plan limits; plans can be
# granted by a platform administrator, and the Billing page explains that payments aren't set up.
# Create one recurring monthly Price per paid plan in Stripe and paste the price ids.
# Webhook endpoint: <API_URL>/api/webhooks/stripe  with events checkout.session.completed,
#   customer.subscription.created / updated / deleted, invoice.payment_failed
# Enable the customer portal (Settings → Billing → Customer portal) for plan changes and cancellation.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=

# --- Email (optional) ---------------------------------------------------------
# Delivery for briefings, reports and alerts chosen "also by email". Without it,
# automations send in-app notifications only and say so in each run.
# e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
EMAIL_FROM="Business Command AI <no-reply@example.com>"

# --- Worker -------------------------------------------------------------------
WORKER_CONCURRENCY=3
# Comma-separated connector ids whose provider approval is pending (shown as "Provider access pending").
PROVIDER_ACCESS_PENDING=
