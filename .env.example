# --- AI brain -------------------------------------------------------------
# Anthropic API key. Without it JARVIS runs in "offline mode" with a simple
# keyword-based assistant so you can still try the UI.
ANTHROPIC_API_KEY=
# Claude model + effort (low | medium | high). Low keeps voice replies snappy.
JARVIS_MODEL=claude-opus-5-5
JARVIS_EFFORT=low

# --- Server ---------------------------------------------------------------
PORT=8787
# Encrypts every stored account credential. REQUIRED in production
# (NODE_ENV=production). Generate one with:  openssl rand -base64 32
# Keep it safe — if you lose it, users have to reconnect their accounts.
JARVIS_SECRET=
# Where the SQLite database lives (default: server/data).
JARVIS_DATA_DIR=
# Set to "false" to stop new people signing up (private install).
JARVIS_ALLOW_SIGNUP=true
# Set when running behind a reverse proxy so rate limiting sees real client IPs
# (e.g. "1" for one proxy hop, or "true").
TRUST_PROXY=
# Public URL of the web app (used for OAuth redirects and CORS).
APP_URL=http://localhost:5173
# Public URL of this API server (used to build the Google OAuth redirect URI).
SERVER_URL=http://localhost:8787

# --- Google (Gmail + Calendar) OAuth --------------------------------------
# Create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add
#   http://localhost:8787/api/oauth/google/callback
# as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
